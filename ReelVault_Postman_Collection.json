{
  "info": {
    "name": "ReelVault API",
    "description": "API collection for ReelVault FastAPI Backend deployed on Vercel or running locally.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://reel-vault-7r89.vercel.app",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "reelId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Health Checks",
      "item": [
        {
          "name": "Healthz (Liveness)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/healthz",
              "host": ["{{baseUrl}}"],
              "path": ["healthz"]
            }
          }
        },
        {
          "name": "Readyz (DB Readiness)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/readyz",
              "host": ["{{baseUrl}}"],
              "path": ["readyz"]
            }
          }
        }
      ]
    },
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Sign Up",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.session && res.session.access_token) {",
                  "    pm.collectionVariables.set('token', res.session.access_token);",
                  "    pm.collectionVariables.set('refreshToken', res.session.refresh_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "signup"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.access_token) {",
                  "    pm.collectionVariables.set('token', res.access_token);",
                  "    pm.collectionVariables.set('refreshToken', res.refresh_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User (/me)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "me"]
            }
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.access_token) {",
                  "    pm.collectionVariables.set('token', res.access_token);",
                  "    pm.collectionVariables.set('refreshToken', res.refresh_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "refresh"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"all_devices\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Reels Core",
      "item": [
        {
          "name": "Create / Save Reel",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.reel_id) {",
                  "    pm.collectionVariables.set('reelId', res.reel_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://www.instagram.com/reel/DFf8k3Vsz8P/\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/reels",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "reels"]
            }
          }
        },
        {
          "name": "List Reels",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/reels?limit=50&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "reels"],
              "query": [
                { "key": "limit", "value": "50" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        },
        {
          "name": "Get Single Reel",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/reels/{{reelId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "reels", "{{reelId}}"]
            }
          }
        },
        {
          "name": "Update Reel Title",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Custom Reel Title\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/reels/{{reelId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "reels", "{{reelId}}"]
            }
          }
        },
        {
          "name": "Delete Reel",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/reels/{{reelId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "reels", "{{reelId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "3. AI Verification & Deep Cook",
      "item": [
        {
          "name": "Start Deep Cook (Async Research)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"summary\": \"\",\n  \"transcript\": \"\",\n  \"title\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/reels/{{reelId}}/deep-cook",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "reels", "{{reelId}}", "deep-cook"]
            }
          }
        },
        {
          "name": "Get Deep Cook Status & Report",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/reels/{{reelId}}/deep-cook",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "reels", "{{reelId}}", "deep-cook"]
            }
          }
        },
        {
          "name": "Verify Reel via Tavily Search",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"query\": \"Google Summer of Code 2026 stipend and eligibility\",\n  \"title\": \"GSoC Opportunity\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/reels/{{reelId}}/verify-tavily",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "reels", "{{reelId}}", "verify-tavily"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Productivity Shelf & Link Vault",
      "item": [
        {
          "name": "List Saved Links",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/reels/saved-links",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "reels", "saved-links"]
            }
          }
        },
        {
          "name": "Save Link to Reel",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Application Portal\",\n  \"url\": \"https://summerofcode.withgoogle.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/reels/{{reelId}}/saved-links",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "reels", "{{reelId}}", "saved-links"]
            }
          }
        },
        {
          "name": "List Saved Dates",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/reels/saved-dates",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "reels", "saved-dates"]
            }
          }
        },
        {
          "name": "Save Date to Reel",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Application Deadline\",\n  \"event_date\": \"2026-11-15\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/reels/{{reelId}}/saved-dates",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "reels", "{{reelId}}", "saved-dates"]
            }
          }
        },
        {
          "name": "List Link Vault Entries",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/reels/link-vault",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "reels", "link-vault"]
            }
          }
        },
        {
          "name": "Save Link Vault Entry",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"GSoC 2026 Resources\",\n  \"links\": [\n    {\n      \"name\": \"Portal\",\n      \"url\": \"https://summerofcode.withgoogle.com\"\n    }\n  ],\n  \"topics\": [\"Internship\", \"Open Source\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/reels/{{reelId}}/link-vault",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "reels", "{{reelId}}", "link-vault"]
            }
          }
        }
      ]
    }
  ]
}
