APP_ENV=dev
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:5173","http://localhost:5173"]

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

SOCIALKIT_API_KEY=
TAVILY_API_KEY=

# Gemini API Keys for reel analysis, research & verification
# You can provide multiple keys. ReelVault automatically rotates them and
# fails over to the next key if one key hits a rate limit or quota exhaustion.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Or comma-separated:
# GEMINI_API_KEYS=key1,key2,key3

# Optional — default model is gemini-3.5-flash-lite
# LLM_MODEL_FAST=gemini-3.5-flash-lite
# LLM_MODEL_MAIN=gemini-3.5-flash-lite
